{
  "name": "base-bun-server",
  "version": "0.0.0",
  "private": true,
  "description": "Bun HTTP service template (Hono + Drizzle + SQLite)",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@infra-x/oxfmt-presets": "0.0.4",
    "@infra-x/oxlint-presets": "0.0.2",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
